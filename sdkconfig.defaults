CONFIG_IDF_TARGET="esp32c6"

# Measured with esptool flash-id on the soldered ESP32-C6 DevKit (2026-11-06).
# A move to a bare module is planned; re-check this then.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# The default of 3584 is too small for the code ported from the Arduino loop task.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# BLE (M9): IDF's NimBLE, the stack the old firmware used through NimBLE-Arduino.
# One link at a time; central and peripheral, since the role depends on the
# two MACs. 517 as in the old firmware's NimBLEDevice::setMTU(517). No
# pairing or bonding is used, so the security manager is left out.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=517
# CONFIG_BT_NIMBLE_SECURITY_ENABLE is not set

# Wi-Fi portal (M10): the HTTP server keeps up to 13 sockets open (phones
# open several at once), plus DNS and the server's own; as the IDF
# captive_portal example.
CONFIG_LWIP_MAX_SOCKETS=16

# LVGL (A1). Renders 8-bit luminance (L8); the flush callback packs it into
# the panel's 2bpp. Memory comes from the heap, so it shows in heap stats.
# Logs go through printf. Montserrat 12/16/20 next to the default 14, to
# judge sizes on the real screen.
CONFIG_LV_COLOR_DEPTH_8=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_PRINTF=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
# QR codes for the Wi-Fi setup and profile link pages.
CONFIG_LV_USE_QRCODE=y
